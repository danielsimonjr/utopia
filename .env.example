# Copy this file to .env, then change values as needed. Every setting uses a UTOPIA_ prefix.
UTOPIA_DATABASE_URL=postgres://utopia:utopia@localhost:1517/utopia
UTOPIA_BIND_ADDR=0.0.0.0:1516
# JWT signing key. Leave this empty. Utopia generates one key on first start and stores it in the database.
# Set this only to rotate the key, or to align several instances on the same key.
# UTOPIA_JWT_SECRET=
# Directory for the frontend build output. When this directory exists, the server hosts the SPA from it.
UTOPIA_WEB_DIST=web/dist
# Data directory: raw files (files/) and the full-text index (index/).
UTOPIA_DATA_DIR=data
# Force the Secure flag on session cookies. Leave this empty. Over TLS, Utopia sets the flag from the X-Forwarded-Proto header.
# Set this only when your reverse proxy does not send that header.
# UTOPIA_COOKIE_SECURE=true
# Open registration. When false, only the first user can register; an administrator invites the rest.
UTOPIA_OPEN_REGISTRATION=true
# Maximum size of the database connection pool. The default is 32, matched to the default worker concurrency.
# When the pool is smaller than the concurrency, requests slow down. No error names the pool as the cause.
# Raise worker concurrency and this value together. Do not raise this value above Postgres's own max_connections (default 100).
# UTOPIA_DB_MAX_CONNECTIONS=32

# --- docker-compose reads the following settings. They are not read by the application. ---
# Database password. The default value fits local development only. Change it before a public deployment.
# UTOPIA_DB_PASSWORD=utopia
# Database port mapping. The default binds to loopback, for local development only. Change this when the host port is in use.
# UTOPIA_DB_BIND=127.0.0.1:1517
# When Docker Hub is unreachable, set this to any PG16+ image that includes pgvector.
# UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
# Pin a specific deployment version. The default is latest.
# UTOPIA_IMAGE=ghcr.io/deeplethe/utopia:0.1.0

# --- Restricted database role (optional, recommended for new deployments) ---
# Without this setting, the application runs as the database owner. That role can run DROP TRIGGER,
# and so it can bypass the ledger's immutability constraint. With this setting, the application
# connects as utopia_app instead. That role can read and write business tables as usual. It can only
# insert into the ledger and read it; it cannot change or delete ledger rows. Migrations still run
# through the owner connection, and that connection closes after the migration finishes.
#
# Warning: This role stops application bugs, SQL injection, and a leaked connection string from
# reaching the ledger. It does not stop a person who can log into the server itself, because psql
# inside the container needs no password and runs as superuser. Server access control is a separate concern.
#
# The init script creates this role on the first `up` only. Set all three of the following together:
# UTOPIA_APP_DB_PASSWORD=replace with a random password
# UTOPIA_DATABASE_URL=postgres://utopia_app:the same password above@db:5432/utopia
# UTOPIA_MIGRATION_URL=postgres://utopia:${UTOPIA_DB_PASSWORD}@db:5432/utopia
#
# For a deployment where the data directory already exists, the init script does not run.
# Create the role by hand:
#   docker compose exec db psql -U utopia -d utopia \
#     -c "CREATE ROLE utopia_app LOGIN PASSWORD 'replace with a random password';"
# Then set the three variables above and restart. The next migration grants the needed permissions.
