# The build context needs only source code. Without these excludes, sending the context to the
# Docker daemon takes minutes. A host node_modules/ would also overwrite the one the container
# installs, and the two are not binary-compatible when the host is Windows or macOS.
target/
crates/
**/node_modules/
.git/
.github/
data/
web/dist/
docs/
.claude/
.env
*.log
